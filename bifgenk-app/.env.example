# Postgres connection string. Added automatically when you connect a Neon
# database from the Vercel Marketplace (Storage tab). Locally, run
# `vercel env pull .env.local` to copy it from your Vercel project.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Optional: direct (non-pooled) connection used for migrations. Neon sets this too.
DATABASE_URL_UNPOOLED=

# Random secret used to sign sessions. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the site. Optional on Vercel (detected automatically).
BETTER_AUTH_URL=http://localhost:3000

# Admin account created (or promoted to admin) on every build if it doesn't exist.
# Changing ADMIN_PASSWORD later does NOT change an existing account's password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional, one-off: connection string of the old Supabase database
# (Supabase → Connect → Session pooler). While set, each build copies members
# from Supabase that aren't here yet, keeping their passwords. Remove it once
# the import is done.
SUPABASE_DB_URL=
